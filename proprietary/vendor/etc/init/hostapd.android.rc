on post-fs-data
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/hostapd 0770 wifi wifi
    mkdir /data/vendor/wifi/hostapd/sockets 0770 wifi wifi
    write /data/vendor/wifi/hostapd/hostapd.psk ""
    chown wifi wifi /data/vendor/wifi/hostapd/hostapd.psk
    chmod 0660 /data/vendor/wifi/hostapd/hostapd.psk

#NFBD: add soft ap for WCNSI-735 by yuguo.zhang 20240731 start
service hostapd /vendor/bin/hw/hostapd
    interface aidl android.hardware.wifi.hostapd.IHostapd/default
    interface aidl vendor.transsion.hardware.wifi.hostapd.IHostapd/default
    class main
    capabilities NET_ADMIN NET_RAW
    user wifi
    group wifi net_raw net_admin
    disabled
    oneshot
#NFBD: add soft ap for WCNSI-735 by yuguo.zhang 20240731 end
